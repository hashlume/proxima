+// seekerStatView is one seeker as /seeker/stats reports it.
+type seekerStatView struct {
+	Name     string  `json:"name"`
+	Hashrate float64 `json:"hashrate"`
+	Attempts uint64  `json:"attempts"`
+	AgeMs    int64   `json:"age_ms"`
+}
+
+// seekerStatsView is the answer of GET /seeker/stats.
+type seekerStatsView struct {
+	JobID         uint64           `json:"job_id"`
+	Slot          uint32           `json:"slot"`
+	K             int              `json:"k"`
+	TTLMs         int64            `json:"ttl_ms"`
+	TotalHashrate float64          `json:"total_hashrate"`
+	Seekers       []seekerStatView `json:"seekers"`
+}
+
+// handleStats answers GET /seeker/stats: what each connected seeker last
+// reported, for dashboards. Read-only, behind the same token as the rest.
+func (s *seekerServer) handleStats(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		writeJSON(w, http.StatusMethodNotAllowed, map[string]string{"error": "GET only"})
+		return
+	}
+	now := time.Now()
+	s.mu.Lock()
+	out := seekerStatsView{
+		JobID:   s.job.ID,
+		Slot:    s.slot,
+		K:       s.k,
+		TTLMs:   s.deadline.Sub(now).Milliseconds(),
+		Seekers: make([]seekerStatView, 0, len(s.seekers)),
+	}
+	for name, st := range s.seekers {
+		out.Seekers = append(out.Seekers, seekerStatView{
+			Name:     name,
+			Hashrate: st.hashrate,
+			Attempts: st.attempts,
+			AgeMs:    now.Sub(st.lastSeen).Milliseconds(),
+		})
+		out.TotalHashrate += st.hashrate
+	}
+	s.mu.Unlock()
+	sort.Slice(out.Seekers, func(i, j int) bool { return out.Seekers[i].Hashrate > out.Seekers[j].Hashrate })
+	writeJSON(w, http.StatusOK, out)
+}
